# Fastfile
# Android 배포 자동화 스크립트

opt_out_usage

default_platform(:android)

platform :android do

  # ==================== 내부 테스트 트랙 배포 ====================

  desc "내부 테스트 트랙에 배포"
  desc "사용법: fastlane internal"
  lane :internal do
    # 1. AAB 파일 경로 확인
    aab_path = "../build/app/outputs/bundle/release/app-release.aab"

    unless File.exist?(aab_path)
      UI.user_error!("❌ AAB 파일을 찾을 수 없습니다: #{aab_path}\nFlutter 빌드를 먼저 실행하세요.")
    end

    UI.message("📦 AAB 파일 확인: #{aab_path}")

    # 2. Google Play 내부 테스트 트랙에 업로드
    upload_to_play_store(
      track: "internal",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed"
    )

    UI.success("✅ 내부 테스트 트랙 업로드 완료!")
    UI.success("Google Play Console에서 확인하세요: https://play.google.com/console")
  end

  # ==================== 프로덕션 배포 ====================

  desc "프로덕션 트랙에 배포 (수동 출시)"
  desc "사용법: fastlane production"
  lane :production do
    aab_path = "../build/app/outputs/bundle/release/app-release.aab"

    unless File.exist?(aab_path)
      UI.user_error!("❌ AAB 파일을 찾을 수 없습니다: #{aab_path}\nFlutter 빌드를 먼저 실행하세요.")
    end

    UI.message("📦 AAB 파일 확인: #{aab_path}")

    upload_to_play_store(
      track: "production",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft"
    )

    UI.success("✅ 프로덕션 트랙 업로드 완료! (draft 상태)")
    UI.message("Google Play Console에서 수동으로 출시하세요")
  end

end
